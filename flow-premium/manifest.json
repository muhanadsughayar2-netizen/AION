{
  "manifest_version": 3,
  "key": "",
  "name": "__MSG_extensionName__",
  "version": "2.7.4",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "unlimitedStorage",
    "scripting",
    "clipboardWrite",
    "clipboardRead",
    "downloads",
    "identity",
    "contextMenus",
    "sidePanel"
  ],
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "oauth2": {
    "client_id": "114083338605-8l3tglcrm0npscg721jd4tkjhlltujsm.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile",
      "openid"
    ]
  },
  "options_page": "options.html",
  "host_permissions": [
    "https://grok.x.ai/*",
    "https://grok.com/*",
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://*.openai.com/*",
    "https://gemini.google.com/*",
    "https://perplexity.ai/*",
    "https://www.perplexity.ai/*",
    "https://x.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://www.googleapis.com/*",
    "https://snaptoai.com/*",
    "https://www.snaptoai.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["content.js", "popup.html", "popup.css", "popup.js", "annotate.html", "annotate.css", "annotate.js", "options.html", "options.css", "options.js", "ai-chat.html", "ai-chat.js", "video-pipeline-core.js", "prompts.js", "magic-card.html", "magic-card.js", "sidebar.html", "sidebar.js", "theme.js", "theme.css", "branding.js", "preview-output.html", "preview-output.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: blob: https: https://hits.sh https://lh3.googleusercontent.com https://i.ytimg.com; font-src 'self' data: https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; connect-src 'self' https://www.googleapis.com https://accounts.google.com https://generativelanguage.googleapis.com https://hits.sh https://snaptoai.com https://www.snaptoai.com https://api.whop.com https://whop.com https://fonts.googleapis.com https://fonts.gstatic.com; frame-src 'self' blob: https://www.youtube.com https://www.youtube-nocookie.com https://youtube.com; child-src 'self' blob: https://www.youtube.com https://www.youtube-nocookie.com;",
    "sandbox": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src https://cdn.tailwindcss.com https://unpkg.com 'unsafe-inline' 'unsafe-eval'; style-src 'unsafe-inline' https://fonts.googleapis.com; font-src data: https://fonts.gstatic.com; img-src *;"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://*.openai.com/*",
        "https://claude.ai/*",
        "https://grok.com/*",
        "https://grok.x.ai/*",
        "https://gemini.google.com/*",
        "https://perplexity.ai/*",
        "https://www.perplexity.ai/*",
        "https://x.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "commands": {
    "capture": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Capture screenshot"
    },
    "ask-ai": {
      "suggested_key": {
        "default": "Ctrl+Shift+A",
        "mac": "Command+Shift+A"
      },
      "description": "Ask SnapToAI about current page"
    }
  },
  "sandbox": {
    "pages": ["sandbox.html"]
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
